<Page
    x:Class="LeigodPause.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:LeigodPause"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="DashboardPage"
    d:DesignHeight="450"
    d:DesignWidth="750"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <!-- 错误 / 危险	SystemFillColorCriticalBrush	红 -->
    <!-- 警告	SystemFillColorCautionBrush	黄 -->
    <!-- 提示 / 注意	SystemFillColorAttentionBrush	蓝 -->
    <!-- 成功	SystemFillColorSuccessBrush	绿 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：Dashboard -->
        <ScrollViewer Grid.Column="0"
                      Padding="14,14,10,14"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:TextBlock Text="控制面板"
                              FontSize="22"
                              FontWeight="SemiBold"
                              Margin="0,0,0,2" />
                <ui:TextBlock Text="雷神加速器自动暂停工具"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              Margin="0,0,0,14" />

                <!-- 系统服务状态 -->
                <ui:Card Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="AccessTime24"
                                       FontSize="26"
                                       VerticalAlignment="Center"
                                       Margin="2,0,12,0"
                                       Foreground="{DynamicResource SystemFillColorAttentionBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ui:TextBlock Text="系统服务状态"
                                          FontWeight="Medium" />
                            <ui:TextBlock x:Name="RunningTextBlock"
                                          Text="{Binding IsRunningText}"
                                          Foreground="{DynamicResource AccentTextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:Button x:Name="RunButton"
                                       Content="启动服务"
                                       Margin="0,0,8,0"
                                       Click="RunButton_OnClick"
                                       Visibility="{Binding RunningBtnVisible}">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="{Binding Source={x:Static Application.Current}, Path=(app:App.UacImageSource).Value}" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="InstallButton"
                                       Content="{Binding InstallButtonText}"
                                       Click="InstallButton_OnClick">
                                <ui:Button.Icon>
                                    <ui:ImageIcon Source="{Binding Source={x:Static Application.Current}, Path=(app:App.UacImageSource).Value}" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 账号 -->
                <ui:Card Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Margin="2,2,0,0">
                            <ui:SymbolIcon Symbol="Person20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <ui:TextBlock Text="账号"
                                          FontWeight="Medium"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <ui:TextBlock Text="{Binding LeigodCoreModel.UserName}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                                <ui:Button Icon="{ui:SymbolIcon CommentCheckmark48}"
                                           Content="检查 Token"
                                           Click="TokenBtn_Click" />
                            </StackPanel>
                            <ui:TextBlock Text="网页登录后点击“检查 Token”以同步账号状态"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Margin="0,4,0,0"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- 暂停状态 -->
                <ui:CardControl Margin="0,0,0,12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Pause20" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="暂停状态" FontWeight="Medium" />
                    </ui:CardControl.Header>
                    <ui:CardControl.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="{Binding LeigodCoreModel.PauseStatus}"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                          Margin="0,0,12,0" />
                            <ui:Button Icon="{ui:SymbolIcon Pause48}"
                                       Content="立即暂停"
                                       Visibility="{Binding LeigodCoreModel.IsNotPaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Click="PauseBtn_Click" />
                        </StackPanel>
                    </ui:CardControl.Content>
                </ui:CardControl>

                <!-- 游戏进程 -->
                <ui:CardControl Margin="0,0,0,12">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Window48" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <ui:TextBlock Text="游戏进程" FontWeight="Medium" />
                    </ui:CardControl.Header>
                    <ui:CardControl.Content>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Image Source="{Binding GameImageIcon}"
                                      Width="24" Height="24"
                                      Margin="0,0,8,0" />
                            <ui:TextBlock Text="{Binding LeigodCoreModel.MatchedGameProcess}"
                                          Name="TextBlockMatchedGameProcess"
                                          VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:CardControl.Content>
                </ui:CardControl>

            </StackPanel>
        </ScrollViewer>

        <!-- 右侧：WebView -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Margin="0,0,4,0"
                           IsEnabled="{Binding CanGoBack, ElementName=WebView}"
                           Icon="{ui:SymbolIcon ArrowCircleLeft48}"
                           Click="backBtn_Click" />
                <ui:Button Grid.Column="1" Margin="0,0,4,0"
                           Icon="{ui:SymbolIcon CommentCheckmark48}"
                           Content="检查token"
                           Click="TokenBtn_Click" />
                <ui:TextBox Grid.Column="2" Padding="0"
                            x:Name="UrlText"
                            KeyDown="UrlText_OnKeyDown" />
            </Grid>

            <wv2:WebView2 Grid.Row="1" Name="WebView"
                          NavigationStarting="WebView_OnNavigationStarting"
                          NavigationCompleted="WebView_OnNavigationCompleted"
                          CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"
                          Source="https://www.baidu.com" />
            <ProgressBar Name="ProgressBar"
                         Grid.Row="2"
                         IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>