<Page
    x:Class="LeigodPause.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:LeigodPause"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="DashboardPage"
    d:DesignHeight="450"
    d:DesignWidth="750"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：Dashboard -->
        <StackPanel Grid.Column="0" Margin="12" VerticalAlignment="Top">

            <StackPanel Margin="5"
                        Orientation="Horizontal">
                <Label Content="系统服务状态：" VerticalAlignment="Center"></Label>
                <ui:TextBlock x:Name="RunningTextBlock" Text="{Binding IsRunningText}" VerticalAlignment="Center" />
                <ui:Button x:Name="RunButton" Content="启动服务" Click="RunButton_OnClick" Visibility="{Binding RunningBtnVisible}">
                    <ui:Button.Icon>
                        <ui:ImageIcon Source="{Binding Source={x:Static Application.Current},Path=(app:App.UacImageSource).Value}" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="InstallButton" Content="{Binding InstallButtonText}" Click="InstallButton_OnClick">
                    <ui:Button.Icon>
                        <ui:ImageIcon Source="{Binding Source={x:Static Application.Current},Path=(app:App.UacImageSource).Value}" />
                    </ui:Button.Icon>
                </ui:Button>

            </StackPanel>
            <StackPanel
                Margin="5"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,4,0"
                    Icon="{ui:SymbolIcon CommentCheckmark48}"
                    Content="检查token"
                    Click="TokenBtn_Click" />
                <Label Content="网页登录后点击检查" VerticalAlignment="Center"></Label>
                <ui:Button
                    Visibility="Collapsed"
                    Click="OnBaseButtonClick"
                    Content="Click me!"
                    Icon="{ui:SymbolIcon Fluent24}" />
                <ui:TextBlock
                    Visibility="Collapsed"
                    x:Name="CounterTextBlock"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel
                Margin="5"
                Orientation="Horizontal">
                <ui:TextBlock Text="昵称"
                              Margin="3"
                              VerticalAlignment="Center">
                </ui:TextBlock>
                <ui:TextBlock Text="{Binding LeigodCoreModel.UserName}"
                              Margin="3"
                              VerticalAlignment="Center">
                </ui:TextBlock>
            </StackPanel>
            <StackPanel
                Margin="5"
                Orientation="Horizontal">
                <ui:TextBlock Text="暂停状态"
                              Margin="3"
                              VerticalAlignment="Center">
                </ui:TextBlock>
                <ui:TextBlock Text="{Binding LeigodCoreModel.PauseStatus}"
                              Margin="3"
                              VerticalAlignment="Center">
                </ui:TextBlock>
                <ui:Button
                    Margin="4"
                    Icon="{ui:SymbolIcon Pause48}"
                    Content="立即暂停"
                    Visibility="{Binding LeigodCoreModel.IsNotPaused, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="PauseBtn_Click" />
            </StackPanel>
            <StackPanel
                Margin="5"
                Orientation="Horizontal">
                <ui:TextBlock Text="游戏进程"
                              Margin="3"
                              VerticalAlignment="Center">
                </ui:TextBlock>
                <ui:Image Source="{Binding GameImageIcon}" />

                <ui:TextBlock Text="{Binding LeigodCoreModel.MatchedGameProcess}"
                              Margin="3"
                              Name="TextBlockMatchedGameProcess"
                              VerticalAlignment="Center">

                </ui:TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- 右侧：WebView -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Margin="0,0,4,0"
                           IsEnabled="{Binding CanGoBack, ElementName=WebView}"
                           Icon="{ui:SymbolIcon ArrowCircleLeft48}"
                           Click="backBtn_Click" />
                <ui:Button Grid.Column="1" Margin="0,0,4,0"
                           Icon="{ui:SymbolIcon CommentCheckmark48}"
                           Content="检查token"
                           Click="TokenBtn_Click" />
                <ui:TextBox Grid.Column="2" Padding="0"
                            x:Name="UrlText"
                            KeyDown="UrlText_OnKeyDown" />
            </Grid>

            <wv2:WebView2 Grid.Row="1" Name="WebView"
                          NavigationStarting="WebView_OnNavigationStarting"
                          NavigationCompleted="WebView_OnNavigationCompleted"
                          CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"
                          Source="https://www.baidu.com" />
            <ProgressBar Name="ProgressBar"
                         Grid.Row="2"
                         IsIndeterminate="True" />
        </Grid>
    </Grid>
</Page>