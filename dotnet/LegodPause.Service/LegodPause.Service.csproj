<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFrameworks>net48</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UserSecretsId>dotnet-WorkerService1-12213d12-a590-48ab-a209-1c9ec9239035</UserSecretsId>
        <TargetFrameworks Condition="$(IsUnifiedNETVersion) == 'true'">$(TargetFrameworks);net9.0</TargetFrameworks>
        <TargetFrameworks Condition="$(IsUnifiedNETVersion) == 'false'">$(TargetFrameworks);net9.0-windows</TargetFrameworks>
        <UseWindowsForms Condition="$(IsUnifiedNETVersion) == 'false'">true</UseWindowsForms>

    </PropertyGroup>

    <PropertyGroup Condition="$(IsUnifiedNETVersion) == 'true'">
<!--        <PublishAot>True</PublishAot>-->
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">
    </PropertyGroup>

    <ItemGroup>
        <!--        <PackageReference Include="Microsoft.Extensions.Hosting"/>-->
        <!--        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />-->
        <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="protobuf-net"/>
        <Reference Include="System.Net.Http" />
        <Reference Include="Microsoft.Extensions.Configuration"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)..\config.ini" Condition="Exists('$(SolutionDir)..\config.ini')">
            <Link>config.ini</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
