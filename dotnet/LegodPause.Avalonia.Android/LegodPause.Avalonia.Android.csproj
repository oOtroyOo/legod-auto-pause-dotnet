<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>32</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion>32</AndroidMinSdkVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.CompanyName.LegodPause.Avalonia</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <Import Project="$(OneDrive)\key\app\Sign.props" Condition="Exists('$(OneDrive)\key\app\Sign.props')"/>
  <ItemGroup>
    <AndroidResource Include="$(ProjectDir)..\..\legod.ico">
      <Link>Resources\drawable\legod.ico</Link>
    </AndroidResource>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android"/>
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegodPause.Avalonia\LegodPause.Avalonia.csproj" />
  </ItemGroup>
</Project>
