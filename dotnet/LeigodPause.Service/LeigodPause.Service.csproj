<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFrameworks>net481</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- 与 WPF 共用输出目录：调试时服务 exe 与前端 exe 落在同一文件夹，
             便于 Service.StartMainApp 用 AppContext.BaseDirectory 直接拉起前端，也方便联合部署。 -->
<!--        <OutputPath>..\LeigodPause\bin\$(Configuration)\$(TargetFramework)\win-x64\</OutputPath>-->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <UserSecretsId>dotnet-WorkerService1-12213d12-a590-48ab-a209-1c9ec9239035</UserSecretsId>
<!--        <TargetFrameworks Condition="$(IsUnifiedNETVersion) == 'true'">$(TargetFrameworks);net9.0</TargetFrameworks>-->
<!--        <TargetFrameworks Condition="$(IsUnifiedNETVersion) == 'false'">$(TargetFrameworks);net9.0-windows</TargetFrameworks>-->
        <UseWindowsForms Condition="$(IsUnifiedNETVersion) == 'false'">true</UseWindowsForms>

        <GenerateProgramFile>false</GenerateProgramFile>
        <!-- Microsoft.NET.Test.Sdk 会带Main函数导致重复定义-->
    </PropertyGroup>

    <PropertyGroup Condition="$(IsUnifiedNETVersion) == 'true'">
        <!--        <PublishAot>True</PublishAot>-->
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <Reference Include="System.Text.Encoding.CodePages"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">
        <Reference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <!--        <PackageReference Include="Microsoft.Extensions.Hosting"/>-->
        <!--        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />-->
        <PackageReference Include="ini-parser"/>
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="protobuf-net"/>
        <Reference Include="System.Net.Http"/>
    </ItemGroup>
    

    <ItemGroup>
        <Content Include="$(SolutionDir)\config.ini">
            <Link>config.ini</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <Target Name="StopPauseService" BeforeTargets="Build" Condition="'$(DisableServiceStop)' != 'true'">
        <Exec Command="powershell -Command &quot;Start-Process sc -ArgumentList 'stop LeigodPauseService' -Verb RunAs &quot;"/>
    </Target>
</Project>
