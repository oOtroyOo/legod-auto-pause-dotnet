<Page x:Class="LegodPause.Views.Pages.WebPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="WebViewPage"
      d:DataContext="{Binding RelativeSource={RelativeSource Self}}"
      d:DesignWidth="600"
      d:DesignHeight="700"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>

        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" Margin="0,0,4,0"
                       IsEnabled="{Binding CanGoBack, ElementName=WebView}"
                       Icon="{ui:SymbolIcon ArrowCircleLeft48}"
                       Click="backBtn_Click" />
            <ui:Button Grid.Column="1" Margin="0,0,4,0"
                       Icon="{ui:SymbolIcon CommentCheckmark48}"
                       Content="检查token"
                       Click="backTokenBtn_Click" />
            <ui:TextBox Grid.Column="2" Padding="0"
                        x:Name="UrlText"
                        KeyDown="UrlText_OnKeyDown" />
        </Grid>

        <wv2:WebView2 Grid.Row="1" Name="WebView"
                      NavigationStarting="WebView_OnNavigationStarting"
                      NavigationCompleted="WebView_OnNavigationCompleted"
                      CoreWebView2InitializationCompleted="WebView_CoreWebView2InitializationCompleted"
                      Source="about:blank" />
        <ProgressBar Name="ProgressBar"
                     Grid.Row="2"
                     IsIndeterminate="True" />
    </Grid>


</Page>